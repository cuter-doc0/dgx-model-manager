# DGX Spark Model Manager - Environment Variables
# Pre-configured with defaults. Override via dockhand env vars or edit directly.

# Paths
# Where to store downloaded models
MODELS_PATH=./models

# Hugging Face cache directory
HF_CACHE=~/.cache/huggingface

# Optional: Hugging Face token for private/gated models
# HF_TOKEN=your_token_here

# Ports (change if conflicts with other services)
MANAGER_PORT=4600
LITELLM_PORT=4601
OLLAMA_PORT=4610
SGLANG_PORT=4620
VLLM_PORT=4630
LLAMACPP_PORT=4640
LOCALAI_PORT=4650
COMFYUI_PORT=4660