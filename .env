# DGX Spark Model Manager - Environment Variables
# Pre-configured with defaults. Override via dockhand env vars or edit directly.

# ============================================
# Which services to start (Docker Compose Profiles)
# ============================================
# Comma-separated list. Available: manager,ollama,vllm,sglang,llamacpp,litellm
# Example: COMPOSE_PROFILES=manager,ollama,vllm
COMPOSE_PROFILES=manager,ollama

# ============================================
# Paths
# ============================================
MODELS_PATH=./models
HF_CACHE=~/.cache/huggingface

# Optional: Hugging Face token for private/gated models
# HF_TOKEN=your_token_here

# ============================================
# Ports
# ============================================
MANAGER_PORT=4600
OLLAMA_PORT=4610
VLLM_PORT=4630
SGLANG_PORT=4620
LLAMACPP_PORT=4640
LITELLM_PORT=4601
